---
import type { Project } from '../types';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<section id="projects" class="section projects">
  <div class="section__inner">
    <span class="section__eyebrow reveal">What I've Built</span>
    <h2 class="section__title reveal">Projects</h2>
    <div class="projects__grid reveal-stagger">
      {projects.map((project) => (
        <article class="project-card">
          <div class="project-card__header">
            <span class="project-card__folder"><i class="fas fa-folder"></i></span>
            <div class="project-card__links">
              {project.github && (
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`View ${project.title} on GitHub`}
                >
                  <i class="fab fa-github"></i>
                </a>
              )}
            </div>
          </div>
          <h3 class="project-card__title">{project.title}</h3>
          <p class="project-card__desc">{project.description}</p>
          <ul class="project-card__tags">
            {project.tags.map((tag) => (
              <li class="tag">{tag}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .projects {
    background: var(--color-bg-surface);
  }

  .projects__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .project-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--card-radius);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: border-color var(--transition-base), box-shadow var(--transition-base), transform var(--transition-base);
  }

  .project-card:hover {
    border-color: var(--color-accent-cyan);
    box-shadow: 0 0 24px var(--color-accent-glow), 0 8px 32px rgba(0, 0, 0, 0.3);
    transform: translateY(-4px);
  }

  .project-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .project-card__folder {
    font-size: 1.6rem;
    background: var(--gradient-accent);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    flex-shrink: 0;
  }

  .project-card__links {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .project-card__links a {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .project-card__links a:hover { color: var(--color-accent-cyan); }

  .project-card__title {
    font-size: var(--font-size-lg);
    font-weight: 600;
    color: var(--color-heading);
    line-height: var(--line-height-heading);
  }

  .project-card__desc {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: 1.7;
    flex: 1;
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
  }

  @media (max-width: 480px) {
    .projects__grid { grid-template-columns: 1fr; }
  }
</style>
