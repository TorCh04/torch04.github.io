<section id="contact" class="section contact">
  <div class="section__inner contact__inner reveal">
    <span class="section__eyebrow">Get in Touch</span>
    <h2 class="section__title">Contact</h2>
    <p class="contact__intro">
      Open to internship opportunities, collaborations, and interesting conversations.
      The best way to reach me is by email — I'll get back to you promptly.
    </p>
    <a href="mailto:tor4704@gmail.com" class="btn btn--primary btn--lg">
      tor4704@gmail.com
    </a>
    <ul class="contact__socials">
      <li>
        <a
          href="https://github.com/TorCh04"
          target="_blank"
          rel="noopener noreferrer"
          class="social-icon"
          aria-label="GitHub"
        >
          <i class="fab fa-github"></i>
        </a>
      </li>
      <li>
        <a
          href="https://www.linkedin.com/in/nontapat-chuenkingkaew"
          target="_blank"
          rel="noopener noreferrer"
          class="social-icon"
          aria-label="LinkedIn"
        >
          <i class="fab fa-linkedin"></i>
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  .contact__inner {
    text-align: center;
    max-width: 600px;
  }

  .contact__intro {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    margin-bottom: 2rem;
    line-height: 1.7;
  }

  .contact__socials {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 2rem;
  }
</style>
